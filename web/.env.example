# Where the scoring API lives. The frontend is static and the backend is not,
# so they deploy separately and this is how they find each other.
#
# NEXT_PUBLIC_ because the browser makes the call: there is no server-side
# secret here and nothing to hide. The API has no authentication, which the
# README says out loud.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
