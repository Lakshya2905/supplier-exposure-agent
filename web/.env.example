# How this frontend finds the scoring API, and how it proves it may talk to it.
#
# BOTH ARE READ SERVER-SIDE, by app/api/[...path]/route.ts, at request time.
# Neither is NEXT_PUBLIC_, and that matters twice over: a static frontend ships
# its environment to every visitor, so a key put there is not a key; and a
# NEXT_PUBLIC_ value is inlined at BUILD time, so an address put there cannot be
# changed without a redeploy. Copy this to .env.local, which is gitignored.

# Where the backend is. The default is the server's own loopback, which is the
# right answer locally and nobody's backend on a deployed page.
SEA_API_URL=http://127.0.0.1:8000

# The shared secret the backend was started with, if it was started with one.
# Leave it unset against a backend that has none; the API is open by default.
# Set it to the wrong value, or leave it unset against a backend that wants
# one, and every request is refused before it is read.
SEA_API_KEY=

# ESCAPE HATCH, not the mechanism: this points the BROWSER at a backend
# directly and skips the proxy, so nothing that needs a secret can go down it —
# a backend with a key configured refuses every request made this way. It is
# for a developer working against a local, keyless uvicorn, and it is inlined at
# build time like every other NEXT_PUBLIC_ value.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
